FROM node:22-slim AS deps
WORKDIR /app
COPY package*.json pnpm-lock.yaml* yarn.lock* ./
RUN npm ci

FROM node:22-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# no build step

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /app ./
EXPOSE 3000
CMD ["sh","-c","npm start"]
