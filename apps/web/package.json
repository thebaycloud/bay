{
  "name": "@supersonic/web",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node --import tsx db/migrate.ts",
    "timing": "node --import tsx scripts/deploy-timing.ts",
    "blame": "node --import tsx scripts/failure-blame.ts",
    "test": "node --experimental-test-module-mocks --import tsx --test 'test/**/*.test.ts'",
    "test:collapse": "RUNNER=0 node --experimental-test-module-mocks --import tsx --test test/deploy-pipeline.test.ts",
    "bench": "node --import tsx bench/run.ts",
    "bench:timing": "node --import tsx bench/run.ts --concurrency 1 --modes cold,warm --reps 3",
    "bench:report": "node --import tsx bench/report.ts",
    "bench:watch": "node --import tsx bench/watch.ts",
    "bench:cleanup": "node --import tsx bench/cleanup.ts",
    "drift": "node --import tsx scripts/drift.ts",
    "github:check": "node --import tsx scripts/github-check.ts",
    "deadcode": "knip",
    "film": "esbuild components/film/entry.ts --bundle --format=iife --minify --target=es2020 --outfile=public/film/ship-it.js",
    "prebuild": "npm run film",
    "check:prompts": "node ../../scripts/sync-prompt-rules.mjs --check",
    "check:openapi": "node ../../scripts/sync-openapi.mjs --check"
  },
  "dependencies": {
    "@google-cloud/logging": "^12.3.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.156",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "1.8.2",
    "jose": "^6.2.13",
    "lucide-react": "^0.454.0",
    "nanoid": "^6.0.2",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "@next/env": "^15.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "knip": "^6.43.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
