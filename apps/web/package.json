{
  "name": "@supersonic/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node --import tsx db/migrate.ts",
    "timing": "node --import tsx scripts/deploy-timing.ts",
    "blame": "node --import tsx scripts/failure-blame.ts",
    "test": "node --experimental-test-module-mocks --import tsx --test 'test/**/*.test.ts'",
    "test:collapse": "RUNNER=0 node --experimental-test-module-mocks --import tsx --test test/deploy-pipeline.test.ts",
    "bench": "node --import tsx bench/run.ts",
    "bench:timing": "node --import tsx bench/run.ts --concurrency 1 --modes cold,warm --reps 3",
    "bench:report": "node --import tsx bench/report.ts",
    "bench:watch": "node --import tsx bench/watch.ts",
    "bench:cleanup": "node --import tsx bench/cleanup.ts",
    "drift": "node --import tsx scripts/drift.ts",
    "deadcode": "knip",
    "film": "esbuild components/film/entry.ts --bundle --format=iife --minify --target=es2020 --outfile=public/film/ship-it.js",
    "prebuild": "npm run film"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.80",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@types/pg": "^8.20.0",
    "ai": "^7.0.68",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "1.3.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.454.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "14.2.15",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-jsx-parser": "^2.4.1",
    "shiki": "^4.4.3",
    "streamdown": "^2.5.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.0",
    "tokenlens": "^1.3.1",
    "tsx": "^4.19.1",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "knip": "^6.32.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
