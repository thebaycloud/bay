{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/{error,loading,not-found,template,default}.tsx",
    "middleware.ts",
    "auth.ts",
    "next.config.{js,mjs,ts}",
    "scripts/*.ts",
    "bench/*.ts",
    "db/*.ts",
    "test/**/*.test.ts",
    "components/film/ship-it.js",
    "scripts/film-studio/studio.js"
  ],
  "project": [
    "**/*.{ts,tsx,js}"
  ],
  "ignore": [
    ".next/**",
    "components/ai-elements/**",
    "components/ui/**",
    "node_modules/**"
  ],
  "ignoreDependencies": [
    "tsx"
  ],
  "includeEntryExports": true
}
