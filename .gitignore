node_modules/
.next/
# A second build output, for verifying a production build WITHOUT overwriting the
# one `next dev` is serving: `next build` and `next dev` share `.next`, and
# building over a running dev server 404s every chunk the browser is holding.
# See the NEXT_DIST_DIR branch in apps/web/next.config.mjs.
.next-verify/
out/
dist/
build/
.DS_Store
*.log
npm-debug.log*
.env
.env*.local
.env.local
.pg.json
.sa/
.vercel
*.tsbuildinfo
next-env.d.ts
.turbo/
coverage/
.superpowers/
.gstack/

# Extension signing key — pins the extension ID. Keep it out of git.
extension-key.pem

# Python agent venv
services/outreach-agent/.venv/
__pycache__/
*.egg-info/

# Worktrees created by the harness and by using-git-worktrees. Never committable:
# each one contains a full checkout of this repository.
.claude/worktrees/

# `go build ./...` with no -o drops the fleet agent binary here.
services/fleet/agent/agent

# Bench results are a staging file on the way to bench_runs, plus a live
# status file the watcher reads. Neither is source.
apps/web/bench/results/

# The film, built from apps/web/components/film by `npm run film` (which
# `prebuild` runs, so the image always has it). Generated, ~600 KB, and it moves
# with every change to the picture — the source is the .js in components/film.
apps/web/public/film/

# The cutting room, built from apps/web/scripts/film-studio by
# `node scripts/build-film-studio.mjs`. One 650 KB HTML page with the whole of
# three.js inlined, because it is published as an artifact and an artifact
# fetches nothing. Generated; the source is the two files it is built from.
apps/web/.film-studio.html
