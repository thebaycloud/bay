#!/bin/sh
# Push main → production deploys itself.
#
# Deploys used to be two long gcloud commands someone had to remember, so a merged
# fix could sit dark for hours. This hook fires the same build Cloud Build would run
# from a trigger — the work happens in the cloud, not on your laptop; all that
# happens here is the request.
#
# Only main deploys. Other branches push normally and silently.
#
# Install once, in the repo root:  git config core.hooksPath scripts/git-hooks
# Skip a deploy for one push:      SUPERSONIC_NO_DEPLOY=1 git push

[ -n "$SUPERSONIC_NO_DEPLOY" ] && exit 0

root=$(git rev-parse --show-toplevel) || exit 0
deploying=0

# stdin gives one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in refs/heads/main) ;; *) continue ;; esac
  # All-zero local sha means the branch is being deleted — nothing to deploy.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  deploying=1
  sha=$(echo "$local_sha" | cut -c1-7)
done

[ "$deploying" = 1 ] || exit 0

log="$root/.git/last-deploy.log"
echo "→ deploying $sha to production (cloud build; log: .git/last-deploy.log)"

# Detached and quiet: a deploy takes ~6 minutes and nobody should wait at their
# terminal for it. The push itself is not held up, and a failed deploy leaves the
# reason in the log rather than a dead terminal.
(
  gcloud builds submit "$root" \
    --project supersonic-deploy-prod \
    --config "$root/cloudbuild.yaml" \
    --substitutions "_TAG=$sha" \
    > "$log" 2>&1 \
    && echo "✓ deployed $sha" >> "$log" \
    || echo "✗ deploy of $sha failed — see above" >> "$log"
) < /dev/null > /dev/null 2>&1 &

exit 0
