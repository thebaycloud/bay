{
  "name": "@thebaycloud/cli",
  "version": "1.2.0",
  "description": "Ship & debug Bay apps from your coding agent — the agent-native CLI.",
  "bin": {
    "bay": "./index.js",
    "supersonic": "./index.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "lib/",
    "vendor/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "bundle-detector": "node scripts/bundle-detector.mjs",
    "bundle-resolver": "node scripts/bundle-resolver.mjs",
    "bundle": "npm run bundle-detector && npm run bundle-resolver",
    "test": "node --test",
    "prepublishOnly": "npm run bundle && npm test"
  },
  "keywords": [
    "deploy",
    "cloud",
    "gcp",
    "cloud-run",
    "vibecoding",
    "bay"
  ],
  "homepage": "https://thebay.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebaycloud/bay.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/thebaycloud/bay/issues"
  }
}
